


## include sites-available/shared/collabora.conf;
## Above include file contains this:
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
  }


## https://github.com/ONLYOFFICE/document-server-proxy/blob/master/nginx/proxy-https-to-http.conf

upstream docservice
  {
  server 127.0.0.1:8008;
  ## server http://127.0.0.1;
  ## server http://127.0.0.1:8008;
  ## server backendserver-address;
  }

map $http_host $this_host
  {
  "" $host;
  default $http_host;
  }

map $http_x_forwarded_proto $the_scheme
  {
  default $http_x_forwarded_proto;
  "" $scheme;
  }

map $http_x_forwarded_host $the_host
  {
  default $http_x_forwarded_host;
  "" $this_host;
  }

map $http_upgrade $proxy_connection
  {
  default upgrade;
  "" close;
  }

proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $proxy_connection;
proxy_set_header X-Forwarded-Host $the_host;
proxy_set_header X-Forwarded-Proto $the_scheme;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;


server {
  listen 80 ;
  ## http2 off;

  server_name
    onlyoffice.example.ca
    ;

  location / {
    return 301 https://$host$request_uri;
    }
  }



server {
  listen 443 ssl ;
  ## http2 off;

  server_name
    onlyoffice.example.ca
    ;


  location / {
    proxy_pass http://docservice;
    proxy_http_version 1.1;
    }

  access_log /var/log/nginx/onlyoffice.example_combined.log combined;
  error_log /var/log/nginx/onlyoffice.example_error.log error;


  # Use Mozilla's guidelines for SSL/TLS settings
  # https://mozilla.github.io/server-side-tls/ssl-config-generator/
  ssl_certificate     /etc/letsencrypt/live/office.example.ca/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/office.example.ca/privkey.pem;

  }
